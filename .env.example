# HYENAZ MAFIA MEDIA — environment template
# Copy to .env.local and fill in. NEVER commit real secrets (APEX-STACK §Security).
# Provision these accounts before wiring; the build runs without them and
# degrades gracefully (KICKOFF §8, APEX-STACK §Setup).

# --- Cal.com (booking + Google Calendar sync) — tool 12 ---
# Public booking slug, e.g. "hyenaz/studio-session". Enables the embedded scheduler.
NEXT_PUBLIC_CALCOM_LINK=

# --- Stripe (deposits / tiered payments) — tool 11 ---
# Server-only. Never expose the secret key or webhook secret in the client bundle.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Sanity (CMS: video/photo portfolio, case studies) — Maximal tool 7 ---
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_READ_TOKEN=

# --- ElevenLabs (audio branding / VO — optional, enable only if scoped) ---
ELEVENLABS_API_KEY=
